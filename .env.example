# Quant Trading Simulator - configuration. Copy to .env and fill in what you need.
# Every value is optional: with all of them blank the app runs fully offline
# (bundled demo data, built-in simulator broker, rule-based AI agents).
# NEVER commit .env - it is git-ignored. PAPER trading only.

# --- Core --------------------------------------------------------------------
# SQLite (uv option). Docker Compose overrides this with its Postgres URL.
DATABASE_URL=sqlite:///./data/trader.db
# Host / port for `uv run trader serve` (Docker: host port of the frontend)
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=info
# Comma-separated origins if you serve the UI from another host (blank = same origin only)
CORS_ORIGINS=
# Run the scheduler (bots, always-on agent) inside the web process (= `trader serve --with-worker`)
RUN_SCHEDULER_IN_PROCESS=false
# Seed the demo data automatically when the database is empty
AUTO_SEED=false
DESK_TIMEZONE=Asia/Singapore
# auto | demo | alpaca | twelvedata | equibles | yfinance
DEFAULT_DATA_SOURCE=auto

# --- Alpaca (PAPER account only: alpaca.markets > Paper Trading > API Keys) --
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# iex (free) | sip (paid subscription)
APCA_DATA_FEED=iex

# --- Market data / news ------------------------------------------------------
# twelvedata.com > API keys
TWELVEDATA_API_KEY=
# newsapi.org > Get API key (free Developer plan: development use only)
NEWSAPI_KEY=
# equibles.com > Dashboard > API keys (free plan: 100 requests/day, end-of-day data)
EQUIBLES_API_KEY=
# Reddit (News Sentiment agent): reddit.com/prefs/apps > create another app > type "script".
# Application-only OAuth (client credentials) - reads public posts, never logs in as you.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit asks for a unique, descriptive user agent - include your Reddit username
REDDIT_USER_AGENT=python:algorithmic-trader-bot:v2 (course app)
REDDIT_SUBREDDITS=stocks,wallstreetbets,investing

# --- AI agents ---------------------------------------------------------------
# auto | rules | codex | claude | openai
#   auto  = Codex (your own `codex login`, Sign in with ChatGPT) if logged in,
#           else Claude / OpenAI if an API key is set, else the rule-based agents
AI_PROVIDER=auto
# Claude via the Claude Agent SDK - API key ONLY (Anthropic does not allow third-party
# apps to use Claude.ai subscription login). Or set Bedrock / Vertex env vars instead.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MODEL_DEEP=claude-opus-5-5
# OpenAI Agents SDK (API key)
OPENAI_API_KEY=
# blank = the SDK / CLI default model
OPENAI_MODEL=
CODEX_MODEL=
AGENT_TIMEOUT_S=120
# Stock Trader agent: order size as a fraction of equity (orders are placed automatically on the PAPER account)
AGENT_POSITION_PCT=0.10
# Agent workflow data: auto (every configured source) | offline (no network: cached / demo data)
AGENT_DATA_MODE=auto
ALWAYS_ON_INTERVAL_MIN=60

# --- TradingView webhook -----------------------------------------------------
# Shared secret in the alert JSON. Blank = a random secret is generated locally on first use.
WEBHOOK_SECRET=

# --- Custom-strategy sandbox (local, trusted use) ----------------------------
SANDBOX_TIMEOUT_S=30
SANDBOX_MEMORY_MB=1024

# --- Docker Compose only -----------------------------------------------------
POSTGRES_USER=trader
POSTGRES_PASSWORD=
POSTGRES_DB=trader
# "--extra ai" installs the Claude Agent SDK / OpenAI Agents SDK / Codex SDK in the image
UV_EXTRAS=
